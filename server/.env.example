# Copy to .env for local development (`npm run dev`). On Render these are set in
# the service's Environment tab; render.yaml lists them.

PORT=3000

# MongoDB connection string (subscribers are stored here).
MONGO_DB_URL=

# SMTP account that sends the contact and newsletter emails.
# Without SMTP_PASS the server logs emails to the console instead of sending.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@apsoluts.com
SMTP_PASS=
SMTP_FROM=Apex Root Solutions <contact@apsoluts.com>

# Sign-in for /admin/subscribers. No defaults: with any of these unset (or the
# secret under 32 characters) sign-in is refused.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
ADMIN_TOKEN_SECRET=

# Optional: extra exact origins allowed by CORS, comma-separated.
ALLOWED_ORIGINS=
