# Copy to .env for local development (`npm run dev`). On Render these are set in
# the service's Environment tab; render.yaml lists them.

PORT=3000

# MongoDB connection string (subscribers are stored here).
MONGO_DB_URL=

# Outgoing mail (contact form and newsletter). Preferred: Resend's HTTPS API.
# Create a key at https://resend.com/api-keys. RESEND_FROM must be an address on
# a domain verified in Resend (mail.apexrsol.com is); if empty, SMTP_FROM is used.
RESEND_API_KEY=
RESEND_FROM=Apex Root Solutions <contact@mail.apexrsol.com>

# Fallback, used only when RESEND_API_KEY is empty: SMTP with a mailbox login.
# With neither set the server logs emails to the console instead of sending
# (in production the contact endpoint returns EMAIL_ERROR instead).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@apsoluts.com
SMTP_PASS=
SMTP_FROM=Apex Root Solutions <contact@apsoluts.com>

# Sign-in for /admin/subscribers. No defaults: with any of these unset (or the
# secret under 32 characters) sign-in is refused.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
ADMIN_TOKEN_SECRET=

# Optional: extra exact origins allowed by CORS, comma-separated.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Invoicing and online payments (see docs/INVOICING.md). Test mode first.
# ---------------------------------------------------------------------------

# Currency every project and invoice is billed in. Amounts are stored as whole
# minor units (cents for USD).
BILLING_CURRENCY=USD

# Public address of the website, used for the links in invoice emails and for
# Stripe's return pages. Must be https in production.
SITE_URL=http://localhost:8000

# Signs the private link each client receives. 32+ random characters; changing it
# turns off every invoice link already sent.
# Generate with: openssl rand -base64 48
INVOICE_LINK_SECRET=

# Your business details, printed on every invoice. Required before an invoice can
# be issued; there are no defaults because they are legal facts only you can supply.
# In BUSINESS_ADDRESS a "|" starts a new line.
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Optional. Printed on invoices only if you set them. Ask your accountant what the
# law requires; this software calculates no tax.
BUSINESS_TAX_ID=
INVOICE_TAX_NOTE=
# Optional: invoice numbers are PREFIX-YEAR-0001. Default due date is 14 days.
INVOICE_PREFIX=INV
INVOICE_DEFAULT_DUE_DAYS=14

# Where billing alerts (new quote request, payment received, refund, dispute) go.
# Falls back to SMTP_USER, then contact@apsoluts.com.
ADMIN_NOTIFY_EMAIL=

# Stripe. Use TEST keys (sk_test_...) from https://dashboard.stripe.com/test/apikeys
# and the signing secret of a test-mode webhook endpoint. Never commit these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A live key (sk_live_...) is ignored unless this is exactly "true". Leave unset
# until you have finished testing and chosen to take real payments.
STRIPE_ENABLE_LIVE=

# ---------------------------------------------------------------------------
# Scheduled campaign emails and holiday offers (see docs/CAMPAIGNS.md).
# OFF unless CAMPAIGN_EMAILS_ENABLED is exactly "true".
# ---------------------------------------------------------------------------
CAMPAIGN_EMAILS_ENABLED=
# UTC hour of the day (0-23) the email goes out. 15 = 9 AM US Central (CST).
CAMPAIGN_SEND_HOUR_UTC=15
# Holiday offer: percent off the whole project price, capped in code at 20, and
# how many days before the holiday the offer opens (1-14), and how many of the
# final days (holiday included) get a daily email instead of one every 3 days.
HOLIDAY_DISCOUNT_PERCENT=10
HOLIDAY_WINDOW_DAYS=7
HOLIDAY_DAILY_DAYS=3
# Optional separate sender for campaign mail (for example a marketing subdomain
# verified in Resend), so complaints about promotions cannot affect the address
# that sends invoices and contact-form mail. Falls back to RESEND_FROM.
CAMPAIGN_FROM=

# Automatic "thanks for getting in touch" reply to contact and quote form submissions.
# On unless set to false.
# CONTACT_AUTOREPLY=false
