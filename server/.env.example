# Copy to .env for local development (`npm run dev`). On Render these are set in
# the service's Environment tab; render.yaml lists them.

PORT=3000

# MongoDB connection string (subscribers are stored here).
MONGO_DB_URL=

# Outgoing mail (contact form and newsletter). Preferred: Resend's HTTPS API.
# Create a key at https://resend.com/api-keys. RESEND_FROM must be an address on
# a domain verified in Resend (mail.apexrsol.com is); if empty, SMTP_FROM is used.
RESEND_API_KEY=
RESEND_FROM=Apex Root Solutions <contact@mail.apexrsol.com>

# Fallback, used only when RESEND_API_KEY is empty: SMTP with a mailbox login.
# With neither set the server logs emails to the console instead of sending
# (in production the contact endpoint returns EMAIL_ERROR instead).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@apsoluts.com
SMTP_PASS=
SMTP_FROM=Apex Root Solutions <contact@apsoluts.com>

# Sign-in for /admin/subscribers. No defaults: with any of these unset (or the
# secret under 32 characters) sign-in is refused.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
ADMIN_TOKEN_SECRET=

# Optional: extra exact origins allowed by CORS, comma-separated.
ALLOWED_ORIGINS=
